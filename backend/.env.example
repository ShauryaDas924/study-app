# Runtime (APP_ENV defaults to production when omitted)
APP_ENV=development

# Required: async SQLAlchemy PostgreSQL URL
DATABASE_URL=postgresql+asyncpg://college_ai:change-me@localhost:5432/college_ai

# Required for authenticated API routes
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-public-anon-key

# Required to start the current API and use its AI-backed features
OPENAI_API_KEY=replace-with-your-openai-api-key
MOONSHOT_API_KEY=replace-with-your-moonshot-api-key

# Optional application settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=100
MAX_VISION_OCR_PAGES=10
MAX_IMAGE_PIXELS=25000000
MAX_ARCHIVE_UNCOMPRESSED_BYTES=104857600
CONCEPT_CHUNK_CONCURRENCY=3
ENABLE_REFINEMENT_CACHE=false

# Development-only auth bypass. Never enable this in a public/production environment.
DEV_MODE=false
DEV_USER_ID=00000000-0000-0000-0000-000000000001
